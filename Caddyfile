# DEPRECATED — the verified VPS reverse proxy is Nginx (ports 80/443), not
# Caddy. Kept for reference only; the live config is
# deploy/nginx/learn-aloeducation.conf. Do not install this on the VPS.
learn.aloeducation.com {
    reverse_proxy 127.0.0.1:3017
    encode gzip
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        X-XSS-Protection "1; mode=block"
    }
}
