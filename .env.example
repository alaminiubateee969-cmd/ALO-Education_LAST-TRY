# ALO Learning Journey — Environment Configuration
# Copy to .env and fill values. Never commit real credentials.

# Database (prisma/schema.prisma uses MySQL; SQLite is not supported)
# Replace the placeholder with a new, URL-encoded password before use.
DATABASE_URL="mysql://user_learn:REPLACE_WITH_NEW_URL_ENCODED_PASSWORD@127.0.0.1:3306/db_learn"

# Administrator authentication (single account; RBAC / multi-user roles are not implemented)
# Production requires password + SMS OTP and fails closed unless all listed auth values are configured.
# NEXTAUTH_URL="https://learn.aloeducation.com"
# NEXTAUTH_SECRET="generate-a-unique-secret-outside-the-repository"
# ADMIN_EMAIL="admin@example.com"
# ADMIN_PASSWORD_HASH="scrypt$<base64url-salt>$<base64url-hash>"
# Create a hash without putting the password in shell history:
#   read -rsp 'Admin password: ' p && printf '%s' "$p" | node scripts/hash-admin-password.mjs && unset p
# Fixed E.164 admin phone; the httpSMS-compatible gateway queues the code to its Android handset.
# SMS delivery is external and may incur carrier/provider charges; an HTTP 202 means queued, not delivered.
# ADMIN_OTP_PHONE="+8801XXXXXXXXX"
# HTTPSMS_API_KEY=
# HTTPSMS_FROM="+8801XXXXXXXXX"
# HTTPSMS_BASE_URL="https://api.httpsms.com"  # Optional; use a self-hosted HTTPS endpoint if configured.
# Local development bypasses auth for preview convenience. Set ALO_REQUIRE_AUTH=true to test login locally.
# Set ADMIN_OTP_REQUIRED=true to test the SMS second factor in development.
# ALO_REQUIRE_AUTH=false
# ADMIN_OTP_REQUIRED=false

# AI generation is local-only. No API keys are used for text, images, voice, or music.
# Install Ollama and pull a Bengali-capable instruction model on this machine first.
# Public hosts are rejected by the adapter; use loopback, a private IP, or a local
# Docker service name such as http://ollama:11434.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# Optional local ComfyUI image generation (no RunningHub/cloud endpoint).
COMFYUI_BASE_URL=http://127.0.0.1:8188
# Must match a checkpoint already installed in ComfyUI/models/checkpoints.
# COMFYUI_CHECKPOINT=your-local-checkpoint.safetensors

# Local speech: Piper is preferred when a compatible model is installed; eSpeak is fallback.
# PIPER_BIN=piper
# PIPER_MODEL_PATH=/opt/alo/models/bn_voice.onnx
# ESPEAK_BIN=espeak
VIDEO_FONT_PATH=./public/fonts/HindSiliguri-Bold.ttf

# Social OAuth (all optional — EXTERNAL_SETUP_REQUIRED without these)
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# INSTAGRAM_APP_ID=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# TIKTOK_CLIENT_KEY=
# LINKEDIN_CLIENT_ID=
# TWITTER_CLIENT_ID=
# PINTEREST_APP_ID=

# Telegram
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_CHAT_IDS=8847234

# Inkbox (optional adapter)
# INKBOX_ENDPOINT=
# INKBOX_API_KEY=

# Storage
UPLOAD_DIR=./storage/uploads
VIDEO_DIR=./storage/videos

# Production
PORT=3017
NODE_ENV=production
